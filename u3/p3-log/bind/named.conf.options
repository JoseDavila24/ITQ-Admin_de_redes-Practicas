options {
    directory "/var/cache/bind";

    // Responde a cualquiera; resuelve dominios externos solo para la red de la practica
    allow-query { any; };
    recursion yes;
    allow-recursion { 192.168.30.0/24; 127.0.0.1; };
    forwarders { 8.8.8.8; 1.1.1.1; };
    dnssec-validation auto;

    // Logs: registrar cada pregunta (querylog) y cada respuesta (responselog)
    querylog yes;
    responselog yes;
};
