# ---------------------------------------------------------------
# Valores que puedes modificar (los usa compose.yaml)
# ---------------------------------------------------------------
# Dominio local que resolverá dnsmasq (sin ir a Internet)
DOMINIO=chema.osvp
# IP que dnsmasq devolverá para ese dominio.
# Vacío = la IP actual de tu Ubuntu (así http://chema.osvp abre tu Apache).
# Si quieres otra IP, escríbela aquí (ej. DOMINIO_IP=10.10.10.20).
DOMINIO_IP=
